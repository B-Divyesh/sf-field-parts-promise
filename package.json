{
  "name": "field-parts-promise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "cargo test --manifest-path server/Cargo.toml --locked",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:web": "npm run check && vite build",
    "build": "npm run check && vite build && cargo build --manifest-path server/Cargo.toml --release --locked",
    "preview": "vite preview",
    "format": "prettier --write . && cargo fmt --manifest-path server/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path server/Cargo.toml -- --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.20.0"
  }
}
